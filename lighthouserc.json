{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:8788/index.html",
        "http://127.0.0.1:8788/services.html",
        "http://127.0.0.1:8788/lawn-talk.html",
        "http://127.0.0.1:8788/products.html",
        "http://127.0.0.1:8788/404.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "comment": "404 is intentionally noindex, so the SEO 'is-crawlable' penalty is expected — SEO is not gated here.",
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "comment": "Real content pages. Performance is a warning, not a gate: Lighthouse performance scores vary widely on shared CI runners and are unreliable to fail a build on. Accessibility, best-practices, and SEO are hard gates.",
          "matchingUrlPattern": "^(?!.*404\\.html).*$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
